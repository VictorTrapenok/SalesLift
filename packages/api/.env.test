# Окружение интеграционных тестов.
#
# Порт 5433, а не 5432: тестовая БД изолирована от базы разработки, поэтому
# прогон тестов (который делает TRUNCATE!) не может затереть ваши данные.
# Контейнер поднимает scripts/test-db.sh.
#
# Файл коммитится: секретов здесь нет по определению, а `make test-integration`
# должен работать сразу после клона, без ручной настройки.

APP_ENV=test
APP_MODE=all

DB_HOST=localhost
DB_PORT=5433
DB_NAME=saleslift_test
DB_USER=saleslift_test
DB_PASSWORD=test_password

LOG_LEVEL=warning

JWT_SECRET=test-secret-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=7d
