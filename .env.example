# Рабочая конфигурация для локального запуска.
#
# Этот файл КОММИТИТСЯ и подключается напрямую через `env_file:` в compose.yaml —
# шага «скопируй .env.example в .env» нет намеренно: он лишний и его забывают.
# Личные переопределения кладите в .env (он в .gitignore).
#
# ВНИМАНИЕ: значения ниже пригодны только для локального запуска и демо.
# В production приложение откажется стартовать с этими секретами — см.
# _check_production_secrets в packages/api/src/saleslift/config/settings.py.

# ── Общие ────────────────────────────────────────────────────────────────
APP_ENV=development
# web | worker | all — в compose один процесс делает всё, в k8s режимы разнесены.
APP_MODE=all
PORT=8000

# ── База данных ──────────────────────────────────────────────────────────
# db — имя сервиса в compose.yaml. Для `make dev` (БД в Docker, приложение
# локально) переопределите DB_HOST=localhost в своём .env.
DB_HOST=db
DB_PORT=5432
DB_NAME=saleslift
DB_USER=saleslift
DB_PASSWORD=saleslift

# ── Логирование ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Аутентификация ───────────────────────────────────────────────────────
# В production: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-in-production-min-32
JWT_EXPIRES_IN=7d
