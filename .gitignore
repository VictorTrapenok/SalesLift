# ── Node ──────────────────────────────────────────────────────────────────
node_modules/
packages/web/dist/
# Кэш инкрементальной сборки tsc (`tsc -b`): локальный артефакт, привязанный к
# абсолютным путям машины — в репозитории только конфликтует.
*.tsbuildinfo

# ── Артефакты кодогенерации ───────────────────────────────────────────────
# ВАЖНО: packages/api/schema.graphql НЕ игнорируется, в отличие от прототипа.
# Это контракт API: он коммитится, чтобы его изменения были видны в diff'е при
# ревью, а CI мог поймать «поменял резолвер, но не запустил codegen»
# (job schema-drift в .github/workflows/test.yml).
packages/web/src/graphql/generated/

# ── Локальное окружение ───────────────────────────────────────────────────
# .env.example коммитится с рабочими dev-дефолтами; .env — личные переопределения.
.env
.e2e-artifacts/

# ── Референс-проект: не часть репозитория ─────────────────────────────────
